WITH BaseTratamento AS
(
    /*
        ============================================================
        CTE 1: BaseTratamento
        ============================================================
        Objetivo:
        1. Ler os registros da tabela fato.
        2. Converter DTAFINALIZACAO para texto apenas uma vez.
        3. Evitar a repetição de TRIM e CAST durante o tratamento.
        4. Preservar a granularidade original dos itens pagos.
        * DADOS SENSÍVEIS E PII REMOVIDOS PARA ADEQUAÇÃO À LGPD *
    */
    SELECT
        f.UF,
        f.UFATENDIMENTO,
        f.NROGSP,
        f.NROGSPVINCULADA,
        f.TIPOGSPVINCULADA,
        f.NMEFORMAREEMBOLSO,
        f.DTASOLICITACAOGUIA,

        /* Conversão técnica (não vai para o Power BI) */
        TRIM(
            CAST(f.DTAFINALIZACAO AS VARCHAR)
        ) AS DataFinalizacaoTexto,

        f.PRAZOFINALIZACAO,
        f.FINALIZADOPRAZO30DIAS,
        f.SITUACAOGUIA,
        f.VLRSOLICITADOGUIA,
        f.VLRTOTALPAGOGUIA,
        f.NMETPOITEM,
        f.NROITEMPAGO,
        f.NROSERVICOPAGO,
        f.DESSERVICOPAGO,
        f.VLRPAGOITEM,
        f.QTDSERVICO,
        f.CIDADEUFATENDIMENTO,
        f.DTA_ATENDIMENTO,
        f.SkMotivoDecisaoReembolso,
        f.SkConveniada,
        f.SkEspecialidadeAtendimento,
        f.SkPlano,
        f.SkTipoReembolso,
        f.SkCanalSolicitacao,
        f.CodCBO

    FROM stg_prata.fato_reembolso_itens_pagos AS f
),

BaseDataTratada AS
(
    /*
        ============================================================
        CTE 2: BaseDataTratada
        ============================================================
        Objetivo: Converter DTAFINALIZACAO para o tipo DATE.
    */
    SELECT
        f.UF,
        f.UFATENDIMENTO,
        f.NROGSP,
        f.NROGSPVINCULADA,
        f.TIPOGSPVINCULADA,
        f.NMEFORMAREEMBOLSO,
        f.DTASOLICITACAOGUIA,

        CASE
            WHEN f.DataFinalizacaoTexto IS NULL THEN CAST(NULL AS DATE)
            WHEN f.DataFinalizacaoTexto IN ('', '0', '00000000', '19000101', '1900-01-01') THEN CAST(NULL AS DATE)
            WHEN REGEXP_LIKE(f.DataFinalizacaoTexto, '^[0-9]{8}$') 
                THEN CAST(TRY(DATE_PARSE(f.DataFinalizacaoTexto, '%Y%m%d')) AS DATE)
            WHEN REGEXP_LIKE(f.DataFinalizacaoTexto, '^[0-9]{4}-[0-9]{2}-[0-9]{2}') 
                THEN TRY_CAST(SUBSTR(f.DataFinalizacaoTexto, 1, 10) AS DATE)
            ELSE CAST(NULL AS DATE)
        END AS DTAFINALIZACAO,

        f.PRAZOFINALIZACAO,
        f.FINALIZADOPRAZO30DIAS,
        f.SITUACAOGUIA,
        f.VLRSOLICITADOGUIA,
        f.VLRTOTALPAGOGUIA,
        f.NMETPOITEM,
        f.NROITEMPAGO,
        f.NROSERVICOPAGO,
        f.DESSERVICOPAGO,
        f.VLRPAGOITEM,
        f.QTDSERVICO,
        f.CIDADEUFATENDIMENTO,
        f.DTA_ATENDIMENTO,
        f.SkMotivoDecisaoReembolso,
        f.SkConveniada,
        f.SkEspecialidadeAtendimento,
        f.SkPlano,
        f.SkTipoReembolso,
        f.SkCanalSolicitacao,
        f.CodCBO

    FROM BaseTratamento AS f
),

BaseReembolso AS
(
    /*
        ============================================================
        CTE 3: BaseReembolso
        ============================================================
        Objetivo: Enriquecer itens pagos com atributos descritivos dimensionais.
    */
    SELECT
        f.UF,
        f.UFATENDIMENTO,
        f.NROGSP,
        f.NROGSPVINCULADA,
        f.TIPOGSPVINCULADA,
        f.NMEFORMAREEMBOLSO,
        f.DTASOLICITACAOGUIA,
        f.DTAFINALIZACAO,
        f.PRAZOFINALIZACAO,
        f.FINALIZADOPRAZO30DIAS,
        f.SITUACAOGUIA,
        f.VLRSOLICITADOGUIA,
        f.VLRTOTALPAGOGUIA,
        f.NMETPOITEM,
        f.NROITEMPAGO,
        f.NROSERVICOPAGO,
        f.DESSERVICOPAGO,
        f.VLRPAGOITEM,
        f.QTDSERVICO,
        f.CIDADEUFATENDIMENTO,
        f.DTA_ATENDIMENTO,
        f.SkMotivoDecisaoReembolso,
        f.SkConveniada,
        f.SkEspecialidadeAtendimento,
        f.SkPlano,
        f.SkTipoReembolso,
        f.SkCanalSolicitacao,
        f.CodCBO,

        /* Informações descritivas */
        c.NmeCanalSolicitacao AS canal_solicitacao,
        e.DesEspAtendimento AS especialidade,
        m.NmeMotivoDecisaoReembolso AS motivo_decisao,
        n.NmeConveniada AS conveniada,
        p.NmePlano AS plano,
        t.NmeTipoReembolso AS tipo_reembolso

    FROM BaseDataTratada AS f

    LEFT JOIN stg_prata.dim_canal_solicitacao AS c
        ON f.SkCanalSolicitacao = c.SkCanalSolicitacao
    LEFT JOIN stg_prata.dim_especialidade_atendimento AS e
        ON f.SkEspecialidadeAtendimento = e.SkEspecialidadeAtendimento
    LEFT JOIN stg_prata.dim_motivo_decisao_reembolso AS m
        ON f.SkMotivoDecisaoReembolso = m.SkMotivoDecisaoReembolso
    LEFT JOIN prata.dim_conveniada AS n
        ON f.SkConveniada = n.SkConveniada
    LEFT JOIN prata.dim_plano AS p
        ON f.SkPlano = p.SkPlano
    LEFT JOIN stg_prata.dim_tipo_reembolso AS t
        ON f.SkTipoReembolso = t.SkTipoReembolso
)

/*
    ================================================================
    RESULTADO FINAL
    ================================================================
*/
SELECT DISTINCT
    b.UF,
    b.UFATENDIMENTO,
    b.NROGSP,
    b.NROGSPVINCULADA,
    b.TIPOGSPVINCULADA,
    b.NMEFORMAREEMBOLSO,
    b.DTASOLICITACAOGUIA,
    b.DTAFINALIZACAO,
    b.PRAZOFINALIZACAO,
    b.FINALIZADOPRAZO30DIAS,
    b.SITUACAOGUIA,
    b.VLRSOLICITADOGUIA,
    b.VLRTOTALPAGOGUIA,
    b.NMETPOITEM,
    b.NROITEMPAGO,
    b.NROSERVICOPAGO,
    b.DESSERVICOPAGO,
    b.VLRPAGOITEM,
    b.QTDSERVICO,
    b.CIDADEUFATENDIMENTO,
    b.DTA_ATENDIMENTO,
    b.SkMotivoDecisaoReembolso,
    b.SkConveniada,
    b.SkEspecialidadeAtendimento,
    b.SkPlano,
    b.SkTipoReembolso,
    b.SkCanalSolicitacao,
    b.CodCBO,

    CAST(
        CASE
            WHEN b.NROGSP IS NOT NULL THEN 1
            ELSE 0
        END AS BIGINT
    ) AS Guias,

    b.VLRPAGOITEM AS Valor_pagos,
    b.DTAFINALIZACAO AS Data_finalizacao,

    b.canal_solicitacao,
    b.especialidade,
    b.motivo_decisao,
    b.conveniada,
    b.plano,
    b.tipo_reembolso

FROM BaseReembolso AS b
